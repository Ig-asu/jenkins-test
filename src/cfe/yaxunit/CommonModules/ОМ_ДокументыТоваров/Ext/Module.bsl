#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТест("Тест_ДокументыУспешноСозданы",
			"Создание приходов и расходов без проведения", "Позитив")
		.ДобавитьТест("Тест_ДокументыПроведеныИИмеютДвижения",
			"Проведение приходов и расходов с проверкой движений", "Позитив")
		.ДобавитьТест("Тест_ОстаткиРегистровВНоль",
			"Движения по остаточным регистрам ТоварныеЗапасы и Взаиморасчеты равны нулю", "Позитив")
	;

КонецПроцедуры

Процедура Тест_ДокументыУспешноСозданы() Экспорт

	Контекст = ПодготовитьОбщийКонтекст();

	Приходы = СоздатьДокументыПрихода(Контекст, 4, Ложь);
	Расходы = СоздатьДокументыРасхода(Контекст, 4, Ложь);

	ВсеДокументы = Новый Массив;

	Для Каждого Ссылка Из Приходы Цикл
		ВсеДокументы.Добавить(Ссылка);
	КонецЦикла;

	Для Каждого Ссылка Из Расходы Цикл
		ВсеДокументы.Добавить(Ссылка);
	КонецЦикла;

	ЮТест.ОжидаетЧто(ВсеДокументы.Количество(), "Должно быть создано 8 документов")
		.Равно(8);

	Для Каждого Ссылка Из ВсеДокументы Цикл

		ЮТест.ОжидаетЧто(Ссылка, "Ссылка на документ должна быть заполнена")
			.Заполнено();

		ДокументОбъект = Ссылка.ПолучитьОбъект();

		ЮТест.ОжидаетЧто(ДокументОбъект.Ссылка, "Объект документа должен читаться из ИБ")
			.Равно(Ссылка);

		ЮТест.ОжидаетЧто(ДокументОбъект.Проведен, "Документ не должен быть проведён")
			.ЭтоЛожь();

		ЮТест.ОжидаетЧто(ДокументОбъект.Товары.Количество(), "В каждом документе должна быть строка ТЧ")
			.Равно(1);

	КонецЦикла;

КонецПроцедуры

Процедура Тест_ДокументыПроведеныИИмеютДвижения() Экспорт

	Контекст = ПодготовитьОбщийКонтекст();

	Приходы = СоздатьДокументыПрихода(Контекст, 4, Истина);
	Расходы = СоздатьДокументыРасхода(Контекст, 4, Истина);

	ВсеДокументы = Новый Массив;

	Для Каждого Ссылка Из Приходы Цикл
		ВсеДокументы.Добавить(Ссылка);
	КонецЦикла;

	Для Каждого Ссылка Из Расходы Цикл
		ВсеДокументы.Добавить(Ссылка);
	КонецЦикла;

	Для Каждого Ссылка Из ВсеДокументы Цикл

		ДокументОбъект = Ссылка.ПолучитьОбъект();

		ЮТест.ОжидаетЧто(ДокументОбъект.Проведен, "Документ должен быть проведён")
			.ЭтоИстина();

		ДвиженияТЗ = ЮТЗапросы.ДвиженияДокумента(Ссылка, "ТоварныеЗапасы");
		ДвиженияВР = ЮТЗапросы.ДвиженияДокумента(Ссылка, "Взаиморасчеты");

		ЮТест.ОжидаетЧто(ДвиженияТЗ.Количество(), "Должны быть движения по ТоварныеЗапасы")
			.Больше(0);

		ЮТест.ОжидаетЧто(ДвиженияВР.Количество(), "Должны быть движения по Взаиморасчеты")
			.Больше(0);

	КонецЦикла;

	ЮТест.Контекст().УстановитьЗначение("КонтекстДокументовТоваров", Контекст);

КонецПроцедуры

Процедура Тест_ОстаткиРегистровВНоль() Экспорт

	Контекст = ЮТест.Контекст().Значение("КонтекстДокументовТоваров");

	Если Контекст = Неопределено Тогда
		Контекст = ПодготовитьОбщийКонтекст();
	КонецЕсли;

	ОстаткиТоваров = ПолучитьОстатокТоварныхЗапасов(Контекст);
	ОстаткиВзаиморасчетов = ПолучитьОстатокВзаиморасчетов(Контекст);

	ЮТест.ОжидаетЧто(ОстаткиТоваров, "Остаток товаров на складе должен быть нулевым")
		.Равно(0);

	ЮТест.ОжидаетЧто(ОстаткиВзаиморасчетов, "Остаток взаиморасчетов должен быть нулевым")
		.Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяТестовойОрганизации()
	Возврат "YAxUnit Организация";
КонецФункции

Функция ИмяТестовогоСклада()
	Возврат "YAxUnit Склад";
КонецФункции

Функция ИмяТестовогоКонтрагента()
	Возврат "YAxUnit Контрагент";
КонецФункции

Функция ИмяТестовогоТовара()
	Возврат "Товар для YAxUnit-теста";
КонецФункции

Функция ПодготовитьОбщийКонтекст()

	Контекст = Новый Структура;
	Контекст.Вставить("Валюта", Справочники.Валюты.ПустаяСсылка());

	Контекст.Вставить("Организация",
		ПолучитьИлиСоздатьЭлементСправочника("Справочники.Организации", ИмяТестовойОрганизации()));

	Контекст.Вставить("Склад",
		ПолучитьИлиСоздатьЭлементСправочника("Справочники.Склады", ИмяТестовогоСклада()));

	Контекст.Вставить("Контрагент",
		ПолучитьИлиСоздатьЭлементСправочника("Справочники.Контрагенты", ИмяТестовогоКонтрагента()));

	Контекст.Вставить("Товар", ПолучитьИлиСоздатьТестовыйТовар());
	Контекст.Вставить("ВидЦен", Справочники.ВидыЦен.Закупочная);

	ЮТест.Контекст().УстановитьЗначение("КонтекстДокументовТоваров", Контекст);

	Возврат Контекст;

КонецФункции

Функция НайтиЭлементСправочникаПоНаименованию(ИмяМенеджера, Наименование)

	ИмяСправочника = СтрЗаменить(ИмяМенеджера, "Справочники.", "");

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТаблицаСправочника.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК ТаблицаСправочника
		|ГДЕ
		|	ТаблицаСправочника.Наименование = &Наименование
		|	И НЕ ТаблицаСправочника.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	ТаблицаСправочника.Код",
		ИмяСправочника);

	Запрос.УстановитьПараметр("Наименование", Наименование);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Ссылка;

КонецФункции

Функция ПолучитьИлиСоздатьЭлементСправочника(ИмяМенеджера, Наименование)

	Ссылка = НайтиЭлементСправочникаПоНаименованию(ИмяМенеджера, Наименование);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат ЮТест.Данные().КонструкторОбъекта(ИмяМенеджера)
		.Установить("Наименование", Наименование)
		.Записать();

КонецФункции

Функция ПолучитьИлиСоздатьТестовыйТовар()

	Ссылка = НайтиЭлементСправочникаПоНаименованию("Справочники.Товары", ИмяТестовогоТовара());

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат ЮТест.Данные().КонструкторОбъекта("Справочники.Товары")
		.Установить("Наименование", ИмяТестовогоТовара())
		.Установить("Вид", Перечисления.ВидыТоваров.Товар)
		.Записать();

КонецФункции

Функция СгенерироватьДанныеСтрокиТовара(Контекст, Индекс)

	Количество = 10 + Индекс * 3;
	Цена = 100 + Индекс * 50;
	Сумма = Количество * Цена;

	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("Товар", Контекст.Товар);
	ДанныеСтроки.Вставить("Количество", Количество);
	ДанныеСтроки.Вставить("Цена", Цена);
	ДанныеСтроки.Вставить("Сумма", Сумма);

	Возврат ДанныеСтроки;

КонецФункции

Функция СоздатьДокументПриходТовара(Контекст, ДанныеСтроки, Проводить = Истина)

	Конструктор = ЮТест.Данные().КонструкторОбъекта("Документы.ПриходТовара");

	Конструктор
		.Установить("Дата", ТекущаяДатаСеанса())
		.Установить("Организация", Контекст.Организация)
		.Установить("Склад", Контекст.Склад)
		.Установить("Поставщик", Контекст.Контрагент)
		.Установить("Валюта", Контекст.Валюта);

	Конструктор.ТабличнаяЧасть("Товары");
	ДобавитьСтрокиТоваров(Конструктор, ДанныеСтроки);

	Если Проводить Тогда
		Возврат Конструктор.Провести();
	Иначе
		Возврат Конструктор.Записать();
	КонецЕсли;

КонецФункции

Функция СоздатьДокументРасходТовара(Контекст, ДанныеСтроки, Проводить = Истина)

	Конструктор = ЮТест.Данные().КонструкторОбъекта("Документы.РасходТовара");

	Конструктор
		.Установить("Дата", ТекущаяДатаСеанса())
		.Установить("Организация", Контекст.Организация)
		.Установить("Склад", Контекст.Склад)
		.Установить("Покупатель", Контекст.Контрагент)
		.Установить("ВидЦен", Контекст.ВидЦен)
		.Установить("Валюта", Контекст.Валюта);

	Конструктор.ТабличнаяЧасть("Товары");
	ДобавитьСтрокиТоваров(Конструктор, ДанныеСтроки);

	Если Проводить Тогда
		Возврат Конструктор.Провести();
	Иначе
		Возврат Конструктор.Записать();
	КонецЕсли;

КонецФункции

Процедура ДобавитьСтрокиТоваров(Конструктор, ДанныеСтроки)

	Если ТипЗнч(ДанныеСтроки) = Тип("Массив") Тогда

		Для Каждого СтрокаДанных Из ДанныеСтроки Цикл
			Конструктор.ДобавитьСтроку(СтрокаДанных);
		КонецЦикла;

	ИначеЕсли ДанныеСтроки <> Неопределено Тогда
		Конструктор.ДобавитьСтроку(ДанныеСтроки);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьДокументыПрихода(Контекст, КоличествоДокументов = 4, Проводить = Истина)

	МассивСсылок = Новый Массив;

	Для Индекс = 0 По КоличествоДокументов - 1 Цикл
		ДанныеСтроки = СгенерироватьДанныеСтрокиТовара(Контекст, Индекс);
		Ссылка = СоздатьДокументПриходТовара(Контекст, ДанныеСтроки, Проводить);
		МассивСсылок.Добавить(Ссылка);
	КонецЦикла;

	Возврат МассивСсылок;

КонецФункции

Функция СоздатьДокументыРасхода(Контекст, КоличествоДокументов = 4, Проводить = Истина)

	МассивСсылок = Новый Массив;

	Для Индекс = 0 По КоличествоДокументов - 1 Цикл
		ДанныеСтроки = СгенерироватьДанныеСтрокиТовара(Контекст, Индекс);
		Ссылка = СоздатьДокументРасходТовара(Контекст, ДанныеСтроки, Проводить);
		МассивСсылок.Добавить(Ссылка);
	КонецЦикла;

	Возврат МассивСсылок;

КонецФункции

Функция ПолучитьОстатокТоварныхЗапасов(Контекст)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ТоварныеЗапасыОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварныеЗапасы.Остатки(
	|			,
	|			Товар = &Товар
	|				И Склад = &Склад) КАК ТоварныеЗапасыОстатки";

	Запрос.УстановитьПараметр("Товар", Контекст.Товар);
	Запрос.УстановитьПараметр("Склад", Контекст.Склад);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Возврат Выборка.КоличествоОстаток;

КонецФункции

Функция ПолучитьОстатокВзаиморасчетов(Контекст)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ВзаиморасчетыОстатки.СуммаОстаток, 0) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.Взаиморасчеты.Остатки(
	|			,
	|			Контрагент = &Контрагент
	|				И Валюта = &Валюта) КАК ВзаиморасчетыОстатки";

	Запрос.УстановитьПараметр("Контрагент", Контекст.Контрагент);
	Запрос.УстановитьПараметр("Валюта", Контекст.Валюта);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Возврат Выборка.СуммаОстаток;

КонецФункции

#КонецОбласти
